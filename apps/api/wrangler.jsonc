{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-habit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // この Worker は API 専用。静的アセットは持たない。
  // 管理画面は apps/web の workout-habit-admin Worker が配信し、/api/* を
  // Service Binding でここへ中継する。同一オリジン扱いになるため CORS は持たない
  // （.agents/rules/api.md）。
  //
  // スキーマ変更は migrations/ に連番SQLを足し、
  // `npx wrangler d1 migrations apply workout-habit-db --remote` で適用する。
  // 適用状況は D1 の d1_migrations テーブルが持つ。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workout-habit-db",
      "database_id": "97bb04b6-96cd-4714-9ae1-a5db14b30071",
      "migrations_dir": "migrations"
    }
  ],
  // レート制限（暴走・総当たりの頭打ち）。上限値の正本はここ。
  // namespace_id は Worker 内で一意な任意の整数（秘密値ではない）。period は 10 か 60 のみ。
  // 判定は「場所ごと・ベストエフォート」であり、正確な計数には使わない。
  // limiter 呼び出し自体の失敗を許可に倒す理由は src/middleware/rateLimit.ts を見る。
  "ratelimits": [
    {
      // 認証失敗（401 の直前）。キーは接続元 IP。トークン総当たりの頭打ち。
      "name": "AUTH_FAILURE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // POST /sync/operations。キーは認証済み userId。クライアント暴走時の D1 保護。
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // POST /admin/api-tokens。キーは認証済み userId。トークンの大量発行を防ぐ。
      "name": "TOKEN_ISSUE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
