{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-habit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // この Worker は API 専用。静的アセットは持たない。
  // 管理画面は apps/web の workout-habit-admin Worker が配信する（別オリジン）。
  // そのため CORS が必要。許可オリジンは ALLOWED_ORIGINS シークレットで渡す。
  //
  // スキーマ変更は migrations/ に連番SQLを足し、
  // `npx wrangler d1 migrations apply workout-habit-db --remote` で適用する。
  // 適用状況は D1 の d1_migrations テーブルが持つ。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workout-habit-db",
      "database_id": "97bb04b6-96cd-4714-9ae1-a5db14b30071",
      "migrations_dir": "migrations"
    }
  ]
}
