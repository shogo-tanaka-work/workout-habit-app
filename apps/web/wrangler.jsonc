{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 管理画面（分析ダッシュボード）の Worker。
  // vite のビルド成果物を配信し、/api/* を workout-habit-api へ中継する。
  //
  // このホストへ Cloudflare Access をまるごと適用して、許可メール以外を入口で止める。
  // 画面と API を同一オリジンに寄せているのは、Access の JWT が
  // 「Access を掛けたホスト宛のリクエスト」にしか付かないため（worker/index.ts の説明を参照）。
  "name": "workout-habit-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // クライアントルーティングを持たない SPA だが、
    // 未知のパスで 404 を出さないためフォールバックさせる。
    "not_found_handling": "single-page-application",
    // 既定ではアセットが先に解決され、一致しないパスは SPA フォールバックへ回る。
    // そのままだと /api/* も index.html になり Worker まで届かないため、
    // 中継対象のパスだけ Worker を先に走らせる。
    "run_worker_first": ["/api/*"]
  },
  // Worker 間の直接呼び出し。公開インターネットを経由しない。
  "services": [
    {
      "binding": "API",
      "service": "workout-habit-api"
    }
  ]
}
