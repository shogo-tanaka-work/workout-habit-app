{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-habit-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // apps/web（分析ダッシュボード）のビルド成果物を同一オリジンで配信する。
  // API のパスだけ Worker を先に通し、それ以外は静的アセットを返す。
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/backup", "/health", "/analytics/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workout-habit-db",
      "database_id": "97bb04b6-96cd-4714-9ae1-a5db14b30071"
    }
  ]
}
